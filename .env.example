# Copy to .env.local and set what you need. Everything is optional.

# This site's public address, for share previews (Open Graph images).
# NEXT_PUBLIC_SITE_URL=https://moodverse.example

# The MoodVerse API (../MoodVerse_bd). The server calls MOODVERSE_API_URL;
# the browser is sent to NEXT_PUBLIC_MOODVERSE_API_URL for Google sign-in.
MOODVERSE_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_MOODVERSE_API_URL=http://127.0.0.1:8080

# Development: answer API calls with the sample data in src/mocks.
# NEXT_PUBLIC_API_MOCKING=1

# Features behind flags until they are reviewed.
# NEXT_PUBLIC_VOICE=1
# NEXT_PUBLIC_ARABIC=1

# Support. The helpline directory defaults to https://findahelpline.com; the
# "Tell us if this keeps happening" link is hidden without an email.
# NEXT_PUBLIC_SUPPORT_DIRECTORY_URL=
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Store badges on the landing page (not linked, and read as "coming soon", when unset).
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=

# Counts only (see src/lib/telemetry.ts). Nothing is sent when unset.
# NEXT_PUBLIC_ANALYTICS_URL=
